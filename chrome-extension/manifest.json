{
  "manifest_version": 3,
  "name": "MacBridge Go — Background Browser",
  "version": "1.0.0",
  "description": "A persistent background tab workspace and native Go bridge for your signed-in Chrome profile.",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "nativeMessaging",
    "alarms",
    "management",
    "identity",
    "identity.email"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "MacBridge background workspace"
  },
  "key": ""
}
